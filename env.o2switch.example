# Configuration BorneFlix pour O2switch
# Copiez ce fichier vers .env et personnalisez les valeurs

# ========================================
# BASE DE DONNÉES
# ========================================
DB_HOST=localhost
DB_USER=borneflix_user
DB_PASSWORD=your_secure_password_here
DB_NAME=borneflix_db
DB_PORT=3306
DB_SSL=false

# ========================================
# EMAIL (SMTP O2switch)
# ========================================
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=587
SMTP_USER=contact@borneflix.com
SMTP_PASS=your_email_password_here
SMTP_SECURE=false

# ========================================
# APPLICATION
# ========================================
NODE_ENV=production
PORT=3000
SESSION_SECRET=your_very_secure_session_secret_here

# ========================================
# APIS EXTERNES
# ========================================
SENDGRID_API_KEY=your_sendgrid_api_key_here
GOOGLE_ANALYTICS_ID=your_ga_id_here
FACEBOOK_APP_ID=your_fb_app_id_here

# ========================================
# DOMAINE
# ========================================
DOMAIN=borneflix.com
PROTOCOL=https

# ========================================
# SÉCURITÉ
# ========================================
CORS_ORIGIN=https://borneflix.com
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# ========================================
# LOGS
# ========================================
LOG_LEVEL=info
LOG_FILE=./logs/app.log 